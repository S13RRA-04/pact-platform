# Copy to .env for local development. Never commit real secrets.
# PACT_ENV: development | test | production
PACT_ENV=development
# Development persona switcher. Ignored (fails closed) unless PACT_ENV=development.
PACT_DEV_PERSONAS=true
PACT_DATABASE_URL=postgresql+psycopg://pact:pact_dev_only@127.0.0.1:55432/pact
PACT_TEST_DATABASE_URL=postgresql+psycopg://pact:pact_dev_only@127.0.0.1:55432/pact_test
# Required outside development. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
PACT_SESSION_SECRET=
PACT_DB_PASSWORD=pact_dev_only
# Persistent release scheduler. Multiple API replicas coordinate through a PostgreSQL advisory lock.
PACT_SCHEDULER_ENABLED=true
PACT_SCHEDULER_INTERVAL_SECONDS=30
# Development uses a backend-private directory. Production requires provider=r2 and all R2 values.
PACT_OBJECT_STORAGE_PROVIDER=filesystem
PACT_OBJECT_STORAGE_DIRECTORY=.data/protected-documents
PACT_R2_ENDPOINT_URL=
PACT_R2_BUCKET=
PACT_R2_ACCESS_KEY_ID=
PACT_R2_SECRET_ACCESS_KEY=
PACT_DOWNLOAD_TOKEN_SECONDS=300
# Required in production. The scanner uses ClamAV's INSTREAM protocol after PPTX content disarm.
PACT_CLAMAV_HOST=
PACT_CLAMAV_PORT=3310
PACT_CLAMAV_TIMEOUT_SECONDS=30
# Opt-in CI test credentials must point to an isolated staging bucket; see r2-integration.yml.
PACT_R2_TEST_ENDPOINT_URL=
PACT_R2_TEST_BUCKET=
PACT_R2_TEST_ACCESS_KEY_ID=
PACT_R2_TEST_SECRET_ACCESS_KEY=
